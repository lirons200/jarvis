# JARVIS — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. JARVIS runs
# perfectly with an empty file — the bridge authenticates off your Claude Code
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it gives you a much better voice and Scribe transcription. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the JARVIS_* and
#     ELEVENLABS_API_KEY variables from its shell environment AND from
#     .env.local, which it loads itself at startup (needs Node >= 20.12).
#     A variable already set in the shell wins over the file.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell or from .env.local
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-opus-5.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort. Default high.
# JARVIS_EFFORT=high

# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# JARVIS can look at anything and change nothing. `npm run bridge:writes` sets
# this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included; this is
# for anything outside them, such as an external drive of footage. Default: none.
# JARVIS_FILE_ROOTS=

# Address the bridge binds to. Default 127.0.0.1 (this machine only). The
# container deploy sets 0.0.0.0 behind a loopback-only port mapping. The
# WebSocket is NOT authenticated, so never expose it publicly (deploy/README.md).
# JARVIS_BRIDGE_HOST=127.0.0.1

# Log every agent message type to the bridge console. Set to 1 to enable. Default off.
# JARVIS_DEBUG=0

# ElevenLabs voice id for the bridge's own speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional. With it, JARVIS speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=


# ===================================================================
# FOREX / TRADING / TELEGRAM  (bridge; all optional)
# ===================================================================
# !!  WARNING: AUTONOMOUS TRADING PLACES REAL ORDERS.  !!
# Try everything on an OANDA PRACTICE account first, for a good while, before
# you even think about a live one. Trading is OFF unless you deliberately set
# every switch below. Put real credentials only in .env.local (git-ignored),
# never in this file and never in a commit.
#
# Everything below is commented out and shows the default (or "none").
#   - Trading needs JARVIS_TRADING_ENABLED=true AND JARVIS_TRADING_ARM=true,
#     plus every risk limit below. ARM is checked fresh at every boot and is
#     never persisted: a restart without it comes up with trading off.
#   - Live (real money) needs JARVIS_OANDA_ENV=live AND
#     JARVIS_OANDA_ALLOW_LIVE=true. Otherwise the bridge refuses to start it.

# --- OANDA credentials (shared by the price feed, backtests and trading) ---
# OANDA personal access token. Unset = forex feed, backtests and trading off.
# JARVIS_OANDA_API_KEY=<your practice-account token>
# OANDA account id. Unset = same as above.
# JARVIS_OANDA_ACCOUNT_ID=<your practice account id>
# Which OANDA environment: practice or live. Default practice.
# JARVIS_OANDA_ENV=practice
# Second lock for live: must be exactly "true" when JARVIS_OANDA_ENV=live. Default unset.
# JARVIS_OANDA_ALLOW_LIVE=

# --- Read-only forex price feed (also feeds the HUD and Telegram) ---
# Instruments to poll, comma separated. Default EUR_USD,GBP_USD,USD_JPY.
# JARVIS_FOREX_PAIRS=EUR_USD,GBP_USD,USD_JPY
# Poll interval in ms, clamped to 2000-60000. Default 10000.
# JARVIS_FOREX_POLL_INTERVAL_MS=10000

# --- Autonomous trading (MA crossover on daily candles) ---
# Master switch, must be exactly "true". Default unset = off.
# JARVIS_TRADING_ENABLED=
# Arm switch, must be exactly "true" at EVERY boot. Never persisted. Default unset.
# Keep it out of any auto-restarting env file (see deploy/README.md).
# JARVIS_TRADING_ARM=
# Pairs to trade, comma separated. REQUIRED when trading is enabled; no default.
# JARVIS_TRADING_PAIRS=EUR_USD,GBP_USD
# Max units per trade (positive number). REQUIRED; no default.
# JARVIS_TRADING_MAX_POSITION_UNITS=<units>
# Max summed units across all open positions. REQUIRED; no default.
# JARVIS_TRADING_MAX_TOTAL_UNITS=<units>
# Loss in account currency that halts trading for the day. REQUIRED; no default.
# JARVIS_TRADING_MAX_DAILY_LOSS=<amount>
# Stop-loss distance as a multiple of the 14-period ATR. REQUIRED; no default.
# JARVIS_TRADING_ATR_STOP_MULTIPLIER=<multiple>
# How often the trading loop sweeps its pairs, in ms. REQUIRED; no default.
# JARVIS_TRADING_POLL_INTERVAL_MS=<ms>

# --- Telegram remote control (both needed, or the bot stays off) ---
# Bot token from @BotFather. Default unset = Telegram off.
# JARVIS_TELEGRAM_BOT_TOKEN=<token from BotFather>
# The one numeric chat id the bot answers; all other chats are ignored. Default unset.
# JARVIS_TELEGRAM_CHAT_ID=<your numeric chat id>

# --- Running on a server ---
# See deploy/README.md: Docker/systemd files, the /health endpoint, and why
# JARVIS_TRADING_ARM must stay out of an auto-restarting env file.


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). No API key, and every MCP
#            server in your Claude Code config is available.
#   direct — the browser calls the Claude API itself. Needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep the port in step with JARVIS_BRIDGE_PORT above.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when no ElevenLabs voice is active.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. Required if and only if
# VITE_BACKEND=direct, and it ships to the browser, so use it only for a local
# demo. The default bridge mode never reads it. Default: none.
# VITE_ANTHROPIC_API_KEY=
